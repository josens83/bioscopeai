# ========================================
# 프로덕션 환경 설정
# ========================================
# 사용법: 이 파일을 .env.prod로 복사하고 실제 값으로 변경하세요
# cp .env.prod.example .env.prod

# ========================================
# 데이터베이스 설정 (PostgreSQL)
# ========================================
DB_USER=postgres
DB_PASSWORD=your-strong-password-here-change-me
DB_NAME=bioscopeai
REDIS_PASSWORD=your-redis-password-here-change-me

# ========================================
# 보안 키 (CRITICAL - 반드시 변경 필요)
# ========================================
# 아래 명령어로 생성 가능:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-production-secret-key-here-CHANGE-ME
JWT_SECRET_KEY=your-jwt-secret-key-here-CHANGE-ME

# ========================================
# OpenAI API
# ========================================
OPENAI_API_KEY=sk-proj-your-actual-openai-api-key

# ========================================
# Stripe 결제 (프로덕션 키 사용!)
# ========================================
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ========================================
# PubMed API
# ========================================
PUBMED_EMAIL=your-email@example.com
PUBMED_API_KEY=your-pubmed-api-key-optional

# ========================================
# CORS 설정 (프로덕션 도메인)
# ========================================
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# ========================================
# SMTP 이메일 설정
# ========================================
# Gmail 사용 시:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@bioscopeai.com

# SendGrid 사용 시:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key

# ========================================
# Sentry 에러 추적 (선택사항)
# ========================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_TRACES_SAMPLE_RATE=0.1

# ========================================
# 프론트엔드 URL
# ========================================
FRONTEND_URL=https://yourdomain.com

# ========================================
# React 빌드 설정
# ========================================
VITE_API_URL=https://yourdomain.com/api/v1

# ========================================
# 배포 체크리스트
# ========================================
# ✅ 모든 비밀번호와 키를 강력한 값으로 변경했는지 확인
# ✅ Stripe 키가 프로덕션 키 (sk_live_, pk_live_)인지 확인
# ✅ CORS_ORIGINS에 실제 도메인이 설정되어 있는지 확인
# ✅ SMTP 설정이 올바른지 테스트 이메일 발송으로 확인
# ✅ SSL 인증서가 설정되어 있는지 확인 (Let's Encrypt 권장)
# ✅ nginx.prod.conf에서 yourdomain.com을 실제 도메인으로 변경
# ✅ Stripe 웹훅 URL을 https://yourdomain.com/api/v1/subscriptions/webhook으로 설정
