# 프로덕션 환경 변수 템플릿
# 이 파일을 복사하여 .env.prod로 저장하고 실제 값으로 변경하세요

# 데이터베이스
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
DB_NAME=bioscopeai

# Redis
REDIS_PASSWORD=CHANGE_THIS_TO_STRONG_REDIS_PASSWORD

# 백엔드 환경 변수
ENVIRONMENT=production
DEBUG=False

# 보안 (필수 - 반드시 강력한 랜덤 문자열로 변경!)
SECRET_KEY=CHANGE_THIS_TO_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JWT_SECRET_KEY=CHANGE_THIS_TO_RANDOM_JWT_SECRET_KEY_AT_LEAST_32_CHARS

# OpenAI API (필수)
OPENAI_API_KEY=sk-your-production-openai-api-key

# Stripe 결제 (프로덕션 키 사용)
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-production-webhook-secret

# PubMed API
PUBMED_EMAIL=your-email@yourdomain.com
PUBMED_API_KEY=your-pubmed-api-key-if-you-have-one

# CORS 설정 (실제 도메인으로 변경)
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# 프론트엔드 빌드 환경 변수
VITE_API_URL=https://api.yourdomain.com

# 보안 팁:
# 1. 모든 SECRET_KEY는 최소 32자 이상의 랜덤 문자열 사용
# 2. DB_PASSWORD, REDIS_PASSWORD는 강력한 비밀번호 사용
# 3. 프로덕션에서는 반드시 HTTPS 사용
# 4. 이 파일을 Git에 커밋하지 마세요 (.gitignore에 추가)
# 5. 환경 변수는 서버 관리 도구(Docker Secrets, AWS Secrets Manager 등) 사용 권장
