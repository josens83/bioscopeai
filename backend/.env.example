# 애플리케이션 설정
ENVIRONMENT=development  # development, staging, production
APP_NAME=BioscopeAI
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# 데이터베이스 설정
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bioscopeai
DATABASE_POOL_SIZE=10              # 커넥션 풀 크기
DATABASE_MAX_OVERFLOW=20          # 최대 오버플로우
DATABASE_POOL_TIMEOUT=30          # 커넥션 타임아웃 (초)
DATABASE_POOL_RECYCLE=3600        # 커넥션 재활용 시간 (초)

# Redis 설정
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300               # 캐시 TTL (초, 기본 5분)

# JWT 설정
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key

# Stripe 결제
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# CORS 설정
CORS_ORIGINS=["http://localhost:3000","http://localhost:19006"]

# Rate Limiting 설정
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60          # 기본 분당 요청 제한
RATE_LIMIT_PER_HOUR=1000          # 기본 시간당 요청 제한
RATE_LIMIT_STORAGE=memory         # memory 또는 redis (프로덕션은 redis 권장)

# 파일 업로드
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=/tmp/uploads
ALLOWED_EXTENSIONS=pdf,txt,doc,docx

# RAG 설정
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_PATH=/tmp/faiss_index
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# PubMed API
PUBMED_EMAIL=your-email@example.com
PUBMED_API_KEY=your-pubmed-api-key

# Sentry 에러 추적 (선택사항)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# Two-Factor Authentication (2FA)
TWO_FACTOR_ENABLED=True
TWO_FACTOR_ISSUER=BioscopeAI
BACKUP_CODES_COUNT=10             # 백업 코드 개수

# 비밀번호 정책
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_DIGITS=True
PASSWORD_REQUIRE_SPECIAL=True
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# 이메일 설정 (SMTP)
SMTP_ENABLED=True
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@bioscopeai.com
SMTP_FROM_NAME=BioscopeAI

# 프론트엔드 URL
FRONTEND_URL=http://localhost:3000

# Admin 설정
ADMIN_EMAIL=admin@bioscopeai.com
ADMIN_PASSWORD=change-this-admin-password

# 로깅 설정
LOG_LEVEL=INFO                    # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json                   # json 또는 text
LOG_FILE=/var/log/bioscopeai.log

# 보안 헤더
SECURITY_HEADERS_ENABLED=True
HSTS_MAX_AGE=31536000            # HSTS max-age (1년)
CSP_ENABLED=True                  # Content Security Policy

# API 문서
DOCS_ENABLED=True                 # 프로덕션에서는 False 권장
REDOC_ENABLED=True
